generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TripPlan {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  origin      String
  destination String
  mode        String
  resultJson  String
}

model MockOrder {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String
  priceCents  Int
  status      String
  detailsJson String
}

model BixiSnapshot {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  stationId      String
  bikesAvailable Int
  docksAvailable Int
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  role          Role          @default(USER)
  status        AccountStatus @default(APPROVED)

  sessions      Session[]     // ✅ ADD THIS

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
