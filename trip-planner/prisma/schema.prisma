generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TripPlan {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  origin      String
  destination String
  mode        String
  resultJson  String
}

model MockOrder {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String
  priceCents  Int
  status      String
  detailsJson String
}

model BixiSnapshot {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  stationId      String
  bikesAvailable Int
  docksAvailable Int
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(APPROVED)

  sessions     Session[]
  reservation  BikeReservation?
  parkingReservation ParkingReservation?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/**
 * Global stock counter (singleton row).
 * We keep it simple for class project scope: total available reservable bikes.
 */
model BikeStock {
  id        String   @id // "default"
  available Int      @default(20)
  updatedAt DateTime @updatedAt
}

/**
 * Max 1 bike per user: enforced by unique userId.
 * When user cancels, we delete the row (so they can reserve again).
 */
model BikeReservation {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stationId   String
  stationName String

  createdAt   DateTime @default(now())
}

/**
 * Parking reservation:
 * Max 1 parking reservation per user (simple scope like BikeReservation).
 * We keep it persistent for admin analytics.
 */
model ParkingReservation {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  parkingId String
  name      String
  address   String
  lat       Float
  lon       Float

  createdAt DateTime @default(now())
}